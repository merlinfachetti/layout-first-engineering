{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/merlinfachetti/layout-first-engineering/contracts/handoff.schema.json",
  "title": "LFE AgentHandoff v0.1, generated by `lfe handoff` (RFC-0001, 8.7)",
  "type": "object",
  "required": ["schemaVersion", "projectId", "name", "locale", "stage", "gates", "productionCode", "openQuestions", "lastReceipts", "nextAction", "prohibitions", "ledgerHead", "generatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^lfe\\.handoff/0\\.1$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "locale": {"type": "string"},
    "stage": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9"]},
    "gates": {"type": "array", "minItems": 6, "maxItems": 6, "items": {
      "type": "object",
      "required": ["gate", "status", "decisionId", "channel", "boundTo", "reasons"],
      "additionalProperties": false,
      "properties": {
        "gate": {"enum": ["G1", "G2", "G3", "G4", "G5", "G6"]},
        "status": {"enum": ["not_started", "proposed", "approved", "needs_revision", "blocked", "stale", "not_applicable"]},
        "decisionId": {"type": ["string", "null"]},
        "channel": {"type": ["string", "null"]},
        "boundTo": {"type": "array", "items": {"type": "string"}},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "productionCode": {"enum": ["locked", "unlocked"]},
    "openQuestions": {"type": "array", "items": {"type": "object"}},
    "lastReceipts": {"type": "array", "items": {"type": "object"}},
    "nextAction": {"type": "string", "minLength": 1},
    "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ledgerHead": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
