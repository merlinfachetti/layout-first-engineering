{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/merlinfachetti/layout-first-engineering/contracts/baseline.schema.json",
  "title": "LFE ExperienceBaseline v0.1 (RFC-0001, 8.3)",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "title", "medium", "fidelity", "screens", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^lfe\\.baseline/0\\.1$"},
    "id": {"type": "string", "pattern": "^DESIGN-[0-9]{3,}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "medium": {"enum": ["local-html", "figma", "penpot", "image", "spec"]},
    "mediumDecisionId": {"type": "string", "pattern": "^DEC-[0-9]{3,}$"},
    "fidelity": {"enum": ["moodboard", "static-layout", "editable-frames", "interactive-prototype"]},
    "interactionEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVID-[0-9]{3,}$"}},
    "sourceUrl": {"type": "string", "pattern": "^https://"},
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["screenId", "name", "goal", "states", "viewports"],
        "additionalProperties": false,
        "properties": {
          "screenId": {"type": "string", "pattern": "^UI-[0-9]{3,}$"},
          "name": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "states": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["default", "empty", "loading", "error", "success", "disabled"]}},
          "viewports": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["width", "height"], "additionalProperties": false,
            "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}},
          "prototype": {"type": "object", "required": ["path"], "additionalProperties": false,
            "properties": {"path": {"type": "string", "minLength": 1}, "query": {"type": "string"}}},
          "preview": {"type": "object", "required": ["path"], "additionalProperties": false,
            "properties": {"path": {"type": "string", "minLength": 1}}}
        }
      }
    },
    "tokens": {"type": "object", "required": ["path"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}}},
    "flows": {"type": "array", "items": {
      "type": "object", "required": ["id", "steps"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^FLOW-[0-9]{3,}$"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^UI-[0-9]{3,}$"}}
      }}},
    "provenance": {"type": "array", "items": {
      "type": "object", "required": ["asset", "source", "license"], "additionalProperties": false,
      "properties": {"asset": {"type": "string"}, "source": {"type": "string"}, "license": {"type": "string"}}}},
    "files": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  }
}
