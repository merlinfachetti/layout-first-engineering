{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.lfe/state.json)",
      "Edit(/.lfe/decisions.jsonl)",
      "Edit(/.lfe/evidence/**)",
      "Edit(/.lfe/policy.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=/path/to/layout-first-engineering/engine python3 -m lfe --root \"$CLAUDE_PROJECT_DIR\" hook-pre-tool-use || exit 2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=/path/to/layout-first-engineering/engine python3 -m lfe --root \"$CLAUDE_PROJECT_DIR\" hook-session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=/path/to/layout-first-engineering/engine python3 -m lfe --root \"$CLAUDE_PROJECT_DIR\" hook-stop"
          }
        ]
      }
    ]
  }
}
