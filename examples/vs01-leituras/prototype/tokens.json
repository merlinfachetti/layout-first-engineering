{
  "$description": "VS-01 Lista de leituras, direção A (Sumário). Subconjunto do formato W3C Design Tokens (DTCG): só $value, $type, $description e aliases {grupo.token}. Cores em hexadecimal, como no rascunho anterior ao formato estável de cor.",
  "palette": {
    "$type": "color",
    "$description": "Paleta base. A interface não usa estes nomes diretamente: usa os tokens semânticos de color.",
    "papel": { "$value": "#f4f5f0", "$description": "Papel frio, levemente esverdeado; não é creme." },
    "branco": { "$value": "#ffffff" },
    "tinta": { "$value": "#1f2a30", "$description": "Tinta azul-ardósia, para texto e bordas de controle." },
    "grafite": { "$value": "#4f5a60", "$description": "Texto secundário; 6,5:1 sobre o papel." },
    "pontilhado": { "$value": "#8c9590", "$description": "Pontos do sumário; decorativo." },
    "linha": { "$value": "#c7ccc6", "$description": "Fios finos de separação; decorativo." },
    "verde-tinta": { "$value": "#1e5c4f", "$description": "Acento: marca de lida e anel de foco; 7:1 sobre o papel." },
    "marca-texto": { "$value": "#e3ee9e", "$description": "Destaque passageiro da leitura recém-adicionada." },
    "vermelho-revisao": { "$value": "#a12a1f", "$description": "Erros; 6,7:1 sobre o papel." },
    "rosa-revisao": { "$value": "#f8e6e2", "$description": "Fundo de aviso de erro." }
  },
  "color": {
    "$type": "color",
    "surface": {
      "page": { "$value": "{palette.papel}" },
      "raised": { "$value": "{palette.branco}" },
      "error": { "$value": "{palette.rosa-revisao}" },
      "highlight": { "$value": "{palette.marca-texto}" }
    },
    "text": {
      "primary": { "$value": "{palette.tinta}" },
      "muted": { "$value": "{palette.grafite}" },
      "inverse": { "$value": "{palette.papel}" },
      "error": { "$value": "{palette.vermelho-revisao}" }
    },
    "border": {
      "control": { "$value": "{palette.tinta}" },
      "subtle": { "$value": "{palette.linha}" },
      "error": { "$value": "{palette.vermelho-revisao}" }
    },
    "decor": {
      "leader": { "$value": "{palette.pontilhado}" }
    },
    "accent": { "$value": "{palette.verde-tinta}" },
    "focus": { "$value": "{palette.verde-tinta}" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "URW Palladio L", "P052", "Book Antiqua", "Georgia", "serif"],
        "$description": "Só fontes do sistema: a demo roda offline e sem baixar nada."
      }
    },
    "size": {
      "$type": "dimension",
      "small": { "$value": "0.9375rem" },
      "body": { "$value": "1.125rem" },
      "entry": { "$value": "1.375rem", "$description": "Título de cada leitura em telas largas." },
      "entry-compact": { "$value": "1.1875rem", "$description": "Título de cada leitura abaixo de 56rem de largura." },
      "date": { "$value": "1rem" },
      "date-compact": { "$value": "0.875rem" },
      "subtitle": { "$value": "1.25rem" },
      "title": { "$value": "3.25rem" },
      "title-compact": { "$value": "2.375rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "strong": { "$value": 600 }
    },
    "line-height": {
      "$type": "number",
      "body": { "$value": 1.55 },
      "tight": { "$value": 1.15 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },
  "size": {
    "$type": "dimension",
    "measure": { "$value": "40rem", "$description": "Largura da coluna de texto, perto de 70 caracteres." },
    "check": { "$value": "1.5rem", "$description": "Caixa de marcação; alvo de 24px (WCAG 2.2, 2.5.8)." }
  },
  "border": {
    "$type": "dimension",
    "control": { "$value": "2px" },
    "focus": { "$value": "3px" },
    "radius": { "$value": "3px" }
  },
  "motion": {
    "$type": "duration",
    "highlight": { "$value": "1400ms", "$description": "Único movimento: o destaque da leitura nova se apaga. Desligado com prefers-reduced-motion." }
  }
}
